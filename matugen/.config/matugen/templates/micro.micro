# Matugen dynamic theme for micro (generated by DMS / matugen)
# Transparent background to preserve terminal opacity/blur.

color-link default "{{colors.on_surface.default.hex}}"
color-link comment "italic {{colors.outline.default.hex}}"

color-link identifier "{{colors.on_surface.default.hex}}"
color-link identifier.class "bold {{colors.secondary.default.hex}}"
color-link identifier.var "{{colors.on_surface.default.hex}}"

color-link constant "{{colors.tertiary_fixed_dim.default.hex}}"
color-link constant.number "{{colors.tertiary_fixed_dim.default.hex}}"
color-link constant.bool "bold {{colors.tertiary_fixed_dim.default.hex}}"
color-link constant.string "{{colors.tertiary.default.hex}}"
color-link constant.string.char "{{colors.tertiary.default.hex}}"
color-link constant.specialChar "bold {{colors.tertiary_fixed_dim.default.hex}}"

color-link statement "bold {{colors.primary.default.hex}}"
color-link symbol "{{colors.secondary.default.hex}}"
color-link symbol.brackets "{{colors.on_surface_variant.default.hex}}"
color-link symbol.operator "{{colors.secondary.default.hex}}"
color-link symbol.tag "{{colors.primary.default.hex}}"

color-link preproc "{{colors.tertiary.default.hex}}"
color-link type "{{colors.secondary.default.hex}}"
color-link type.keyword "bold {{colors.secondary.default.hex}}"
color-link type.extended "default"

color-link special "{{colors.tertiary.default.hex}}"
color-link underlined "underline {{colors.primary.default.hex}}"
color-link error "bold {{colors.error.default.hex}}"
color-link todo "bold {{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}"

color-link diff-added "{{colors.tertiary.default.hex}}"
color-link diff-modified "{{colors.secondary.default.hex}}"
color-link diff-deleted "{{colors.error.default.hex}}"

color-link hlsearch "bold {{colors.on_primary.default.hex}},{{colors.primary.default.hex}}"
color-link match-brace "bold {{colors.on_secondary_container.default.hex}},{{colors.secondary_container.default.hex}}"
color-link selection "{{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}"

color-link statusline "{{colors.on_surface.default.hex}},{{colors.surface_container_high.default.hex}}"
color-link statusline.inactive "{{colors.on_surface_variant.default.hex}},{{colors.surface_container.default.hex}}"
color-link tabbar "{{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}}"
color-link tabbar.active "bold {{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}"
color-link divider "{{colors.outline_variant.default.hex}},{{colors.surface_container.default.hex}}"

color-link indent-char "{{colors.outline_variant.default.hex}}"
color-link line-number "{{colors.outline.default.hex}}"
color-link current-line-number "bold {{colors.primary.default.hex}}"
color-link gutter-error "{{colors.error.default.hex}}"
color-link gutter-warning "{{colors.tertiary.default.hex}}"

color-link cursor-line ",{{colors.surface_container_low.default.hex}}"
color-link color-column ",{{colors.surface_container_low.default.hex}}"
color-link message "{{colors.on_surface.default.hex}}"
color-link error-message "bold {{colors.error.default.hex}}"
color-link scrollbar "{{colors.outline.default.hex}}"
