// ! DO NOT EDIT !
// ! AUTO-GENERATED BY DMS !
// ! CHANGES WILL BE OVERWRITTEN !
// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

input {
    focus-follows-mouse max-scroll-amount="0%"
    mouse {
        accel-speed 0.0
        accel-profile "adaptive"
        scroll-factor 0.9
    }
    touchpad {
        tap
        accel-speed 0.5
        accel-profile "adaptive"
        natural-scroll
        dwt
        scroll-factor 0.5
    }
    keyboard {
        xkb {
            layout "en,ru"
            variant "qwerty"
            options "grp:win_space_toggle   "
        }
    }
}
