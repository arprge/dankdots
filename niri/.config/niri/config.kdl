// Niri config. KDL format: https://kdl.dev
// Full reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Outputs, input, layout colors and keybinds are managed by DMS
// (see the include list at the bottom); don't duplicate them here.

config-notification {
    disable-failed
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

gestures {
    hot-corners {
        top-left
    }
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}


// Disable blur for bar dropdown popouts so their edges do not expose a
// wallpaper-colored blur line. Toast/notification popups (dms:toast,
// dms:notification-popup) are intentionally excluded. Trailing
// ":background" surfaces match too.
// layer-rule {
//     match namespace="^dms:(control-center|notification-center-popout|battery|color-picker|layout|power-menu|system-update|vpn|focused-window-popout|tray-overflow-menu|tray-menu-window|popout|niri-overview-spotlight|app-launcher|launcher-context-menu|dash|process-list-popout|clipboard-popout|clipboard-context-menu|notepad-context-menu|notification-context-menu|dock-context-menu|dock-trash-context-menu|osd|tooltip)"
//     background-effect {
//         blur false
//         xray false
//     }
// }

overview {
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 300
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float inv = 1.0 - p;
                vec2 c = (coords_geo.xy - 0.5) / mix(0.94, 1.0, p);
                float r2 = dot(c, c) * 4.0;
                c *= 1.0 - inv * 0.10 * r2;
                vec2 uv = c + 0.5;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);
                vec2 ca = c * inv * 0.012;
                vec4 g = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
                float r = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv + ca, 1.0)).st).r;
                float b = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv - ca, 1.0)).st).b;
                return vec4(r, g.g, b, g.a) * smoothstep(0.0, 0.5, p);
            }
        "#
    }
    window-close {
        duration-ms 230
        curve "linear"
        custom-shader r#"
            float melt_hash(vec2 p) {
                p = fract(p * vec2(123.34, 456.21));
                p += dot(p, p + 45.32);
                return fract(p.x * p.y);
            }

            float melt_noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                vec2 u = f * f * (3.0 - 2.0 * f);
                return mix(mix(melt_hash(i), melt_hash(i + vec2(1.0, 0.0)), u.x),
                           mix(melt_hash(i + vec2(0.0, 1.0)), melt_hash(i + vec2(1.0, 1.0)), u.x), u.y);
            }

            // remaining glass: thins from the window's own rounded edges, unevenly
            float melt_height(vec2 px, vec2 size, float melt, float seed) {
                vec2 q = abs(px - 0.5 * size) - 0.5 * size + 16.0;
                float inside = -(length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - 16.0);
                float edge = clamp(inside / 160.0, 0.0, 1.0);
                vec2 np = px / 260.0 + seed * 37.0;
                float n = 0.65 * melt_noise(np) + 0.35 * melt_noise(np * 2.1 + 5.3);
                return 0.55 * sqrt(edge) + 0.45 * n - melt;
            }

            vec4 melt_tex(vec2 uv) {
                return texture2D(niri_tex, (niri_geo_to_tex * vec3(clamp(uv, 0.0, 1.0), 1.0)).st);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                vec2 g = coords_geo.xy;
                if (g.x < 0.0 || g.x > 1.0 || g.y < 0.0 || g.y > 1.0)
                    return vec4(0.0);

                float p = niri_clamped_progress;
                float seed = niri_random_seed;
                vec2 sz = size_geo.xy;
                vec2 px = g * sz;

                float m = mix(-0.06, 1.02, p * p * (1.6 - 0.6 * p));
                float h = melt_height(px, sz, m, seed);
                if (h <= 0.0)
                    return vec4(0.0);

                vec2 gh = vec2(
                    melt_height(px + vec2(2.0, 0.0), sz, m, seed) - melt_height(px - vec2(2.0, 0.0), sz, m, seed),
                    melt_height(px + vec2(0.0, 2.0), sz, m, seed) - melt_height(px - vec2(0.0, 2.0), sz, m, seed)) * 0.25;

                float onset = smoothstep(0.0, 0.2, p);
                float thin = (1.0 - smoothstep(0.0, 0.3, h)) * onset;

                // thin glass bends and diffuses the window's own pixels
                vec2 uv = g + gh * thin * 900.0 / sz;
                vec2 rad = vec2(onset * 2.0 + thin * 9.0) / sz;
                float rot = seed * 6.28318;
                vec4 color = melt_tex(uv);
                for (int i = 0; i < 8; i++) {
                    float fi = float(i);
                    float a = fi * 2.39996 + rot;
                    color += melt_tex(uv + vec2(cos(a), sin(a)) * sqrt((fi + 0.5) / 8.0) * rad);
                }
                color /= 9.0;

                // wet edge catches light in the window's own colors
                color.rgb *= 1.0 + 0.25 * exp(-h / 0.03) * onset;

                float edge = smoothstep(0.0, 0.08, h);
                float fade = 1.0 - smoothstep(0.85, 1.0, p);
                return color * mix(1.0, edge, onset) * mix(1.0, 0.6, thin) * fade;
            }
        "#
    }
    // Melt downward (disabled)
    /-window-close {
        duration-ms 220
        curve "linear"
        custom-shader r#"
            float melt_front(float cx, float e, float seed) {
                float s = seed * 6.28318;
                float amp = 0.05 * sin(3.14159 * e) + 0.01;
                float wob = 0.55 * sin(cx * 2.1 + s + e * 1.3)
                          + 0.30 * sin(cx * 4.7 + s * 1.7 - e * 2.0)
                          + 0.15 * sin(cx * 9.3 + s * 2.3);
                float corner = 0.12 * pow(abs(cx), 3.0) * sin(3.14159 * min(e * 1.4, 1.0));
                return mix(-0.14, 1.08, e) + amp * wob + corner;
            }

            vec4 melt_tex(vec2 uv) {
                return texture2D(niri_tex, (niri_geo_to_tex * vec3(clamp(uv, 0.0, 1.0), 1.0)).st);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                vec2 g = coords_geo.xy;
                if (g.x < 0.0 || g.x > 1.0 || g.y < 0.0 || g.y > 1.0)
                    return vec4(0.0);

                // resists briefly, then accelerates under gravity
                float p = niri_clamped_progress;
                float e = p * p * (1.6 - 0.6 * p);
                float seed = niri_random_seed;

                float cx = g.x * 2.0 - 1.0;
                float band = mix(0.10, 0.28, e);
                float front = melt_front(cx, e, seed);
                if (g.y < front)
                    return vec4(0.0);

                // glass thickness: 0 at the melt front, 1 where still solid
                float s = clamp((g.y - front) / band, 0.0, 1.0);
                float thick = s * s * (3.0 - 2.0 * s);
                float melt = 1.0 - thick;

                float inset = melt * melt * 0.10 * sin(3.14159 * e);
                float side_px = (1.0 - abs(cx) - inset) * 0.5 * size_geo.x;
                if (side_px < 0.0)
                    return vec4(0.0);

                // heightfield slope drives refraction, dispersion and specular
                float dfdx = (melt_front(cx + 0.01, e, seed) - melt_front(cx - 0.01, e, seed)) * 50.0;
                float dts = 6.0 * s * (1.0 - s) / band;
                vec2 grad = vec2(-dfdx * 2.0 * dts / size_geo.x, dts / size_geo.y) * 120.0;
                vec3 n = normalize(vec3(-grad, 1.0));

                vec2 refr = -grad * 14.0 / size_geo.xy;
                float drag = pow(melt, 1.5) * e * 70.0 / size_geo.y;
                vec2 uv = g + refr - vec2(0.0, drag);

                vec4 base = melt_tex(uv);
                vec2 ca = refr * 0.35;
                vec4 sharp = vec4(melt_tex(uv + ca).r, base.g, melt_tex(uv - ca).b, base.a);

                // frost: light haze on the solid slab, heavy diffusion + streak in the melt zone
                float frost = clamp(0.30 * smoothstep(0.15, 0.75, e) + melt * 0.85, 0.0, 1.0);
                vec2 rad = vec2(frost * 8.0) / size_geo.xy;
                vec2 streak = vec2(0.0, -drag * 0.8);
                float rot = seed * 6.28318;
                vec4 blur = base;
                for (int i = 0; i < 8; i++) {
                    float fi = float(i);
                    float a = fi * 2.39996 + rot;
                    vec2 o = vec2(cos(a), sin(a)) * sqrt((fi + 0.5) / 8.0) * rad + streak * (fi / 7.0);
                    blur += melt_tex(uv + o);
                }
                blur /= 9.0;

                vec4 color = mix(sharp, blur, smoothstep(0.0, 0.6, frost));
                color.rgb = mix(color.rgb, color.rgb * 0.9 + vec3(0.08) * color.a, frost * 0.6);

                float edge_px = (g.y - front) * size_geo.y;
                float spec = pow(max(dot(n, vec3(-0.2, -0.43, 0.88)), 0.0), 48.0);
                float rim = exp(-edge_px / 2.5) * 0.35 * melt;
                color.rgb += (spec * 0.55 + rim) * color.a;

                float aa = clamp(edge_px / 1.5, 0.0, 1.0);
                aa *= mix(1.0, clamp(side_px / 1.5, 0.0, 1.0), step(0.0005, inset));
                float fade = 1.0 - smoothstep(0.88, 1.0, p);
                return color * aa * mix(0.6, 1.0, thick) * fade;
            }
        "#
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=323 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}
window-rule {
    match app-id=r#"^dev\.duxlabs\.files$"# title=r#"^(Open|Save|Select|Upload|Export|Import)"#
    open-floating true
}
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}
window-rule {
    match app-id="kitty-yazi"
    default-column-width { fixed 900; }
}

// Steam main client: keep tiled.
window-rule {
    match app-id="^steam$"
    open-floating false
}

// Steam notifications: position at bottom-right.
window-rule {
    match app-id="^steam$" title=r#"^notificationtoasts_\d+_desktop$"#

    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// ---------------

debug {
    honor-xdg-activation-with-invalid-serial
}

// Override to disable super+tab.
recent-windows {
    binds {
        Alt+Tab { next-window scope="output"; }
        Alt+Shift+Tab { previous-window scope="output"; }
        Alt+grave { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// Include dms files
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/cursor.kdl"
include "dms/input.kdl"
include "dms/windowrules.kdl"

binds {
    Print { spawn "dms" "screenshot" "--no-notify"; }
    Mod+MouseBack { focus-column-left; }
    Mod+MouseForward { focus-column-right; }
}

// Override DMS's generated keyboard layout settings.
input {
    keyboard {
        xkb {
            layout "us,ru"
            variant ""
            options "grp:win_space_toggle"
        }
    }
}

blur {
    passes 3
    offset 2.7
    noise 0
    saturation 1.2
}

// Override DMS's generated border and focus-ring colors for a subtle dark look.
layout {
    // Set gaps around windows in logical pixels.
    // Managed by dms/colors.kdl.
    // background-color "transparent"
    focus-ring {
        // Managed by dms/layout.kdl.
        width 1.5
        active-gradient from="#244a38" to="#20403a" angle=45 relative-to="workspace-view" in="oklch longer hue"
        inactive-color "#222222"
    }
    center-focused-column "never"
    preset-column-widths {
        proportion 0.37
        proportion 0.5
        proportion 0.86777
    }
    default-column-width { proportion 0.8; }
    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // If you don't like that, you should uncomment `prefer-no-csd` below.
    // Niri will draw focus ring and border *around* windows that agree to omit their
    // client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.
    border {
        // Managed by dms/layout.kdl and dms/colors.kdl.
        // off
        width 1.5
        active-color   "#3a3a3a"
        inactive-color "#222222"
        // urgent-color   "#cc4444"
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        // Managed by dms/colors.kdl 
        // color "#0007"
    }
}

