// Niri config. KDL format: https://kdl.dev
// Full reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Outputs, input, layout colors and keybinds are managed by DMS
// (see the include list at the bottom); don't duplicate them here.

config-notification {
    disable-failed
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

gestures {
    hot-corners {
        top-left
    }
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}


// Disable blur for bar dropdown popouts so their edges do not expose a
// wallpaper-colored blur line. Toast/notification popups (dms:toast,
// dms:notification-popup) are intentionally excluded. Trailing
// ":background" surfaces match too.
// layer-rule {
//     match namespace="^dms:(control-center|notification-center-popout|battery|color-picker|layout|power-menu|system-update|vpn|focused-window-popout|tray-overflow-menu|tray-menu-window|popout|niri-overview-spotlight|app-launcher|launcher-context-menu|dash|process-list-popout|clipboard-popout|clipboard-context-menu|notepad-context-menu|notification-context-menu|dock-context-menu|dock-trash-context-menu|osd|tooltip)"
//     background-effect {
//         blur false
//         xray false
//     }
// }

overview {
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 300
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float inv = 1.0 - p;
                vec2 c = (coords_geo.xy - 0.5) / mix(0.94, 1.0, p);
                float r2 = dot(c, c) * 4.0;
                c *= 1.0 - inv * 0.10 * r2;
                vec2 uv = c + 0.5;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);
                vec2 ca = c * inv * 0.012;
                vec4 g = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
                float r = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv + ca, 1.0)).st).r;
                float b = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv - ca, 1.0)).st).b;
                return vec4(r, g.g, b, g.a) * smoothstep(0.0, 0.5, p);
            }
        "#
    }
    window-close {
        duration-ms 190
        curve "linear"
        custom-shader r#"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0)
                    return vec4(0.0);
                float p = niri_clamped_progress;
                float e = clamp(p / 0.90, 0.0, 1.0);
                float cx = coords_geo.x * 2.0 - 1.0;
                float bell = 0.5 + 0.5 * cos(3.14159 * cx);
                float wave = sin(3.14159 * e);
                float sag = (0.25 * bell + 0.025 * cos(6.28318 * cx)) * wave;
                float h = clamp((1.0 - e) * (1.0 - 0.35 * bell * wave) - sag * 0.65, 0.0, 1.0);
                float top = 1.0 - h;
                float y = coords_geo.y;
                if (y < top || h <= 0.001)
                    return vec4(0.0);
                float d = (y - top) * size_geo.y;
                float v = 1.0 - (1.0 - y) / max(h, 0.18) * mix(1.0, 0.45, e);
                float meniscus = exp(-d / 24.0);
                v -= meniscus * 0.085 * wave;
                float u = (coords_geo.x - 0.5) / mix(1.0, 0.96, e) + 0.5 + cx * meniscus * 0.022 * wave;
                if (u < 0.0 || u > 1.0)
                    return vec4(0.0);
                vec2 uv = vec2(u, clamp(v, 0.0, 1.0));
                vec2 ca = vec2(cx * 0.004, 0.009) * meniscus * (0.4 + 0.6 * wave);
                vec4 col_g = texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
                float col_r = texture2D(niri_tex, (niri_geo_to_tex * vec3(clamp(uv + ca, 0.0, 1.0), 1.0)).st).r;
                float col_b = texture2D(niri_tex, (niri_geo_to_tex * vec3(clamp(uv - ca, 0.0, 1.0), 1.0)).st).b;
                vec4 color = vec4(col_r, col_g.g, col_b, col_g.a);
                float rim = exp(-d / 3.2) * (1.0 - exp(-d / 1.0)) * 0.24 * (0.35 + 0.65 * wave);
                color.rgb += vec3(rim) * color.a;
                float edge = smoothstep(0.0, 2.0, d);
                float alpha = 1.0 - smoothstep(0.80, 1.0, p);
                return color * edge * alpha;
            }
        "#
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=323 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}
window-rule {
    match app-id=r#"^dev\.duxlabs\.files$"# title=r#"^(Open|Save|Select|Upload|Export|Import)"#
    open-floating true
}
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}
window-rule {
    match app-id="kitty-yazi"
    default-column-width { fixed 900; }
}

// Steam main client: keep tiled.
window-rule {
    match app-id="^steam$"
    open-floating false
}

// Steam notifications: position at bottom-right.
window-rule {
    match app-id="^steam$" title=r#"^notificationtoasts_\d+_desktop$"#

    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// ---------------

debug {
    honor-xdg-activation-with-invalid-serial
}

// Override to disable super+tab.
recent-windows {
    binds {
        Alt+Tab { next-window scope="output"; }
        Alt+Shift+Tab { previous-window scope="output"; }
        Alt+grave { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// Include dms files
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/cursor.kdl"
include "dms/input.kdl"
include "dms/windowrules.kdl"

binds {
    Print { spawn "dms" "screenshot" "--no-notify"; }
    Mod+MouseBack { focus-column-left; }
    Mod+MouseForward { focus-column-right; }
}

// Override DMS's generated keyboard layout settings.
input {
    keyboard {
        xkb {
            layout "us,ru"
            variant ""
            options "grp:win_space_toggle"
        }
    }
}

blur {
    passes 3
    offset 2.7
    noise 0
    saturation 1.2
}

// Override DMS's generated border and focus-ring colors for a subtle dark look.
layout {
    // Set gaps around windows in logical pixels.
    // Managed by dms/colors.kdl.
    // background-color "transparent"
    focus-ring {
        // Managed by dms/layout.kdl.
        width 1.5
        active-gradient from="#244a38" to="#20403a" angle=45 relative-to="workspace-view" in="oklch longer hue"
        inactive-color "#222222"
    }
    center-focused-column "never"
    preset-column-widths {
        proportion 0.37
        proportion 0.5
        proportion 0.86777
    }
    default-column-width { proportion 0.8; }
    // By default focus ring and border are rendered as a solid background rectangle
    // behind windows. That is, they will show up through semitransparent windows.
    // This is because windows using client-side decorations can have an arbitrary shape.
    //
    // If you don't like that, you should uncomment `prefer-no-csd` below.
    // Niri will draw focus ring and border *around* windows that agree to omit their
    // client-side decorations.
    //
    // Alternatively, you can override it with a window rule called
    // `draw-border-with-background`.
    border {
        // Managed by dms/layout.kdl and dms/colors.kdl.
        // off
        width 1.5
        active-color   "#3a3a3a"
        inactive-color "#222222"
        // urgent-color   "#cc4444"
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        // Managed by dms/colors.kdl 
        // color "#0007"
    }
}

