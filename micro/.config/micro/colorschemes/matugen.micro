# Matugen dynamic theme for micro (generated by DMS / matugen)
# Transparent background to preserve terminal opacity/blur.

color-link default "#e8e2d4"
color-link comment "italic #969180"

color-link identifier "#e8e2d4"
color-link identifier.class "bold #d0c7a2"
color-link identifier.var "#e8e2d4"

color-link constant "#a8d0b5"
color-link constant.number "#a8d0b5"
color-link constant.bool "bold #a8d0b5"
color-link constant.string "#a8d0b5"
color-link constant.string.char "#a8d0b5"
color-link constant.specialChar "bold #a8d0b5"

color-link statement "bold #d8c770"
color-link symbol "#d0c7a2"
color-link symbol.brackets "#ccc6b5"
color-link symbol.operator "#d0c7a2"
color-link symbol.tag "#d8c770"

color-link preproc "#a8d0b5"
color-link type "#d0c7a2"
color-link type.keyword "bold #d0c7a2"
color-link type.extended "default"

color-link special "#a8d0b5"
color-link underlined "underline #d8c770"
color-link error "bold #ffb4ab"
color-link todo "bold #f5e388,#514700"

color-link diff-added "#a8d0b5"
color-link diff-modified "#d0c7a2"
color-link diff-deleted "#ffb4ab"

color-link hlsearch "bold #383000,#d8c770"
color-link match-brace "bold #ece3bc,#4d472b"
color-link selection "#f5e388,#514700"

color-link statusline "#e8e2d4,#2c2a21"
color-link statusline.inactive "#ccc6b5,#222017"
color-link tabbar "#e8e2d4,#222017"
color-link tabbar.active "bold #f5e388,#514700"
color-link divider "#4a4739,#222017"

color-link indent-char "#4a4739"
color-link line-number "#969180"
color-link current-line-number "bold #d8c770"
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#a8d0b5"

color-link cursor-line ",#1e1c13"
color-link color-column ",#1e1c13"
color-link message "#e8e2d4"
color-link error-message "bold #ffb4ab"
color-link scrollbar "#969180"
