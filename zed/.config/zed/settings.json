// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cursor_shape": "bar",
  "icon_theme": "Zed (Default)",
  "inline_code_actions": true,
  "vertical_scroll_margin": 3.0,
  "relative_line_numbers": "disabled",
  "gutter": {
    "bookmarks": false,
    "runnables": false,
    "git_gutter_width": "default",
    "min_line_number_digits": 1
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    }
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "model": "gemini-3.8-flash",
        "thinking_level": "medium"
      },
      "type": "registry"
    }
  },
  "languages": {
    "Python": {
      "prettier": {
        "allowed": true
      },
      "document_symbols": "on",
      "document_folding_ranges": "on",
      "inlay_hints": {
        "enabled": true
      },
      "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "fixed"
      }
    },
    "C++": {
      "prettier": {
        "allowed": true
      },
      "colorize_brackets": false,
      "tasks": {
        "prefer_lsp": true
      },
      "indent_guides": {
        
      }
    },
    "JSON": {
      "inlay_hints": {
        "enabled": true
      },
      "indent_guides": {
        "background_coloring": "indent_aware",
        "coloring": "indent_aware"
      }
    }
  },
  "diff_view_style": "unified",
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "show_wrap_guides": true,
  "cursor_animation": {
    "enabled": false,
  },
  "agent_buffer_font_size": 16.0,
  "agent": {
    "default_profile": "write",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "delete_path": {
          "default": "confirm"
        },
        "move_path": {
          "default": "confirm"
        },
        "create_directory": {
          "default": "confirm"
        },
        "write_file": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        }
      }
    },
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "api.github.com"
      ]
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "dock": "left",
  },
  "agent_ui_font_size": 18.0,
  "buffer_font_weight": 450.0,
  "ui_font_weight": 500.0,
  "session": {
    "trust_all_worktrees": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "minimap": {
    "current_line_highlight": "line",
    "thumb_border": "left_open",
    "thumb": "always",
    "show": "auto",
    "max_width_columns": 66,
  },
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_fallbacks": [
    "Fira Code",
    "Consolas",
    "Courier New",
    "monospace",
  ],
  "buffer_font_family": "Google Sans Code",
  "file_scan_exclusions": ["LICENSE", "README.md", "..."],
  "semantic_tokens": "combined",
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "ui_font_size": 18.35,
  "buffer_font_size": 15.5,
  "theme": {
    "mode": "dark",
    "light": "JetBrains Islands Light",
    "dark": "Gruvbox Dark Hard",
  },
  "lsp": {
    "clangd": {
      "binary": {
        "ignore_system_version": false
      }
    }
  }
}
